{
  "name": "axiomap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test && vitest run --passWithNoTests",
    "lint": "eslint .",
    "check": "pnpm build && pnpm test && pnpm lint",
    "check:network": "node scripts/check-no-network-deps.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "prepare": "husky",
    "bench:parser": "node scripts/bench-parser.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:golden": "pnpm --filter @axiomap/core exec vitest run test/golden.test.ts",
    "test:coverage": "pnpm --filter @axiomap/core exec vitest run --coverage.enabled --coverage.provider=v8",
    "package:vsix": "node scripts/package-vsix.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "notices": "node scripts/notices.mjs",
    "test:host": "node scripts/test-extension-host.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify:npm-pack": "node scripts/verify-npm-pack.mjs"
  },
  "devDependencies": {
    "@axiomap/cli": "workspace:^",
    "@axiomap/core": "workspace:^",
    "@axiomap/vscode": "workspace:^",
    "@axiomap/webview": "workspace:^",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.18.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "mocha": "^11.8.0",
    "turbo": "^2.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": "eslint --fix"
  }
}
