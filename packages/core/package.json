{
  "name": "@axiomap/core",
  "version": "0.0.0",
  "private": true,
  "description": "Axiomap engine: parsing, symbols, resolution, graph. No UI, no network, fs only.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "web-tree-sitter": "^0.26.11",
    "xxhash-wasm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "graphology-types": "^0.24.8"
  }
}
