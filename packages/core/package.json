{
  "name": "@axiomap/core",
  "version": "0.0.0",
  "private": false,
  "description": "Axiomap engine: parsing, symbols, resolution, graph. No UI, no network, fs only.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexjkB/axiomap.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/AlexjkB/axiomap#readme",
  "bugs": "https://github.com/AlexjkB/axiomap/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "node ../../scripts/copy-release-files.mjs"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "web-tree-sitter": "^0.26.12",
    "xxhash-wasm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "graphology-types": "^0.24.8"
  }
}
