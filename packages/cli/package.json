{
  "name": "@axiomap/cli",
  "version": "0.0.0",
  "private": false,
  "description": "Graph-based navigation and comprehension for Solidity protocols — CLI. Works on code that does not compile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexjkB/axiomap.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/AlexjkB/axiomap#readme",
  "bugs": "https://github.com/AlexjkB/axiomap/issues",
  "keywords": [
    "solidity",
    "audit",
    "security",
    "graph",
    "ethereum",
    "static-analysis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "axiomap": "./dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "node ../../scripts/copy-release-files.mjs"
  },
  "dependencies": {
    "@axiomap/core": "workspace:*",
    "@axiomap/webview": "workspace:^",
    "commander": "^15.0.0",
    "elkjs": "^0.12.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1"
  }
}
