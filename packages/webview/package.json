{
  "name": "@axiomap/webview",
  "version": "0.0.0",
  "private": true,
  "description": "Axiomap graph UI. Built once, hosted twice: browser and VS Code.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.ui.json && vite build && vite build --config vite.export.config.ts && vite build --config vite.vscode.config.ts",
    "dev": "vite",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@axiomap/core": "workspace:*",
    "cytoscape": "^3.34.0",
    "elkjs": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
