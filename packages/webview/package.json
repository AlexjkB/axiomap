{
  "name": "@axiomap/webview",
  "version": "0.0.0",
  "private": false,
  "description": "Axiomap graph UI. Built once, hosted twice: browser and VS Code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexjkB/axiomap.git",
    "directory": "packages/webview"
  },
  "homepage": "https://github.com/AlexjkB/axiomap#readme",
  "bugs": "https://github.com/AlexjkB/axiomap/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.ui.json && vite build && vite build --config vite.export.config.ts && vite build --config vite.vscode.config.ts",
    "dev": "vite",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "node ../../scripts/copy-release-files.mjs"
  },
  "dependencies": {
    "@axiomap/core": "workspace:*",
    "cytoscape": "^3.34.0",
    "elkjs": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
